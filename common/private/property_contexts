# ATV
# used by mediashell
ro.odm.cast.ssid_suffix u:object_r:odm_cast_prop:s0

# Bluetooth
bluetooth.hci.disabled_commands        u:object_r:bluetooth_config_prop:s0

# Camera
persist.vendor.camera.privapp.list     u:object_r:camera2_extensions_prop:s0
vendor.camera.aux.packageexcludelist   u:object_r:camera2_extensions_prop:s0
vendor.camera.aux.packagelist          u:object_r:camera2_extensions_prop:s0

# Current USB restriction setting, updated to match LineageSettings.Global.TRUST_RESTRICT_USB
persist.init.trust_restrict_usb        u:object_r:trust_restrict_usb_prop:s0 exact int

# Custom version
ro.calyxos.version                     u:object_r:custom_version_prop:s0

# Force multi-window behavior
ro.config.force_multi_window           u:object_r:exported_config_prop:s0 exact bool

# Keychords without adb (3-button bug report)
persist.init.keychords                 u:object_r:exported_keychords_prop:s0 exact bool

# NFC
persist.vendor.nfc.config_file_name    u:object_r:vendor_persist_nfc_prop:s0 exact string
persist.vendor.nfc.fw_file_name        u:object_r:vendor_persist_nfc_prop:s0 exact string

# Security patch
ro.vendor.firmware.security_patch      u:object_r:vendor_security_patch_level_prop:s0 exact string
ro.vendor.kernel.security_patch        u:object_r:vendor_security_patch_level_prop:s0 exact string
ro.build.version.real_security_patch   u:object_r:build_prop:s0 exact string

# Updater, OTA testing
sys.update.                            u:object_r:shell_prop:s0

# xtra-daemon control
persist.sys.xtra-daemon.enabled        u:object_r:xtra_control_prop:s0 exact bool

# Screen mirroring disablement
persist.sysui.disable_mirroring_confirmation_dialog u:object_r:hdmi_config_prop:s0

# USB
ro.usb.uvc.disable_video_encode_flag   u:object_r:usb_uvc_config_prop:s0
vendor.usb.uvc.payload_transfer_size   u:object_r:usb_uvc_config_prop:s0
